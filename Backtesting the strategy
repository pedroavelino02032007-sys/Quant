import argparse
import datetime as dt
import warnings

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.tsa.stattools import adfuller, coint

# ------------------------------------------------------------------ config
TICKERS = ("AMD", "INTC")
YEARS = 5
TRAIN_FRAC = 0.625
WINDOW = 30             # rolling z-score window (days)
ENTRY_Z = 2.0
EXIT_Z = 0.0
STOP_Z = 3.5
MAX_HOLD = 20           # time stop (days)
MAX_TRADE_LOSS = 0.03   # hard stop in REAL P&L: close if a trade loses 3% of equity
LEVERAGE = 1.0          # gross exposure (both legs) as a multiple of equity
COST_BPS = 5.0          # per side, per unit of gross notional (commission + slippage)
START_CAPITAL = 10_000.0
SEED = None             # Set to None for random simulations every run (or an integer for reproducibility)
OUT_PNG = "pairs_backtest.png"


# ------------------------------------------------------------------ data
def make_synthetic(kind, seed, n=1260):
    rng = np.random.default_rng(seed)
    idx = pd.bdate_range(end=pd.Timestamp.today().normalize(), periods=n)
    log_i = np.log(30) + np.cumsum(rng.normal(0.0002, 0.02, n))
    if kind == "coint":
        phi, e = 0.955, np.zeros(n)  # half-life about 15 days
        for t in range(1, n):
            e[t] = phi * e[t - 1] + rng.normal(0, 0.012)
        log_a = np.log(40) + 1.1 * (log_i - log_i[0]) + e
    else:
        log_a = np.log(40) + np.cumsum(rng.normal(0.0004, 0.025, n))
    return pd.DataFrame({TICKERS[0]: np.exp(log_a), TICKERS[1]: np.exp(log_i)}, index=idx)


def load_prices(synthetic=None):
    if synthetic:
        return make_synthetic(synthetic, SEED)
    import yfinance as yf

    end = dt.date.today()
    start = end - dt.timedelta(days=int(365.25 * YEARS))

    px = yf.download(list(TICKERS), start=start, end=end, auto_adjust=True, progress=False)["Close"]
    return px[list(TICKERS)].dropna()


# ------------------------------------------------------------------ stats helpers
def fit_hedge(log_px):
    a, b = log_px[TICKERS[0]], log_px[TICKERS[1]]
    p = sm.OLS(a, sm.add_constant(b)).fit().params
    return p.iloc[0], p.iloc[1]  # alpha, beta


def adf_pvalue(s):
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", FutureWarning)  # statsmodels changes adfuller's return type in 0.16
        return adfuller(s)[1]


def half_life(spread):
    s = spread.dropna()
    d, lag = s.diff().iloc[1:], s.shift(1).iloc[1:]
    k = sm.OLS(d, sm.add_constant(lag)).fit().params.iloc[1]
    return -np.log(2) / np.log(1 + k) if -1 < k < 0 else np.inf


def metrics(ret):
    eq = (1 + ret).cumprod()
    sd = ret.std()
    return {
        "total_return": eq.iloc[-1] - 1,
        "cagr": eq.iloc[-1] ** (252 / len(ret)) - 1,
        "sharpe": ret.mean() / sd * np.sqrt(252) if sd > 0 else np.nan,
        "max_drawdown": (eq / eq.cummax() - 1).min(),
        "pct_days_in_market": None,
    }


# ------------------------------------------------------------------ strategy
def generate_positions(z, spread_ret, scale):
    """State machine. pos[t] = position decided at the close of day t (+1 long spread, -1 short)."""
    pos_arr = np.zeros(len(z))
    trades, pos, entry_i, trade_ret = [], 0, 0, 0.0
    round_trip = 2 * LEVERAGE * COST_BPS / 1e4

    def close_trade(t, reason):
        trades.append({
            "start": z.index[entry_i], "end": z.index[t], "side": "long" if pos == 1 else "short",
            "days": t - entry_i, "gross_ret": trade_ret, "net_ret": trade_ret - round_trip,
            "exit_reason": reason,
        })

    for t in range(len(z)):
        zt = z.iloc[t]
        if np.isnan(zt):
            continue
        if pos != 0:
            trade_ret += pos * scale * spread_ret.iloc[t]  # return earned by yesterday's decision
            held, reason = t - entry_i, None
            if (pos == 1 and zt >= EXIT_Z) or (pos == -1 and zt <= -EXIT_Z):
                reason = "revert"
            elif abs(zt) > STOP_Z:
                reason = "z_stop"
            elif trade_ret < -MAX_TRADE_LOSS:
                reason = "loss_stop"
            elif held >= MAX_HOLD:
                reason = "time_stop"
            if reason:
                close_trade(t, reason)
                pos = 0
        elif -STOP_Z < zt < -ENTRY_Z:
            pos, entry_i, trade_ret = 1, t, 0.0
        elif ENTRY_Z < zt < STOP_Z:
            pos, entry_i, trade_ret = -1, t, 0.0
        pos_arr[t] = pos
    if pos != 0:
        close_trade(len(z) - 1, "open")
    return pd.Series(pos_arr, index=z.index), pd.DataFrame(trades)


# ------------------------------------------------------------------ plotting
def plot(z, trades, equity, path):
    fig, axes = plt.subplots(2, 1, figsize=(14, 9), facecolor="black",
                             gridspec_kw={"height_ratios": [3, 2]})
    for ax in axes:
        ax.set_facecolor("black")
        ax.tick_params(colors="#94a3b8")
        ax.grid(color="#1e293b", linestyle=":", alpha=0.5)
        for s in ax.spines.values():
            s.set_color("#1e293b")

    ax = axes[0]
    ax.plot(z.index, z, color="#38bdf8", lw=1.3)
    for lvl, c in ((ENTRY_Z, "#ef4444"), (-ENTRY_Z, "#10b981"), (0, "#64748b")):
        ax.axhline(lvl, color=c, ls="--", lw=1, alpha=0.8)
    for _, tr in trades.iterrows():
        ax.axvspan(tr["start"], tr["end"], color="#10b981" if tr["net_ret"] > 0 else "#ef4444", alpha=0.25)
    ax.set_title("AMD & INTC Stat arbitrage Backtest strategy",
                 color="white", fontweight="bold")

    axes[1].plot(equity.index, equity, color="#f59e0b", lw=1.6)
    axes[1].axhline(START_CAPITAL, color="#64748b", ls="--", lw=1)
    axes[1].set_title("Portfolio Value ($)", color="white", fontweight="bold")

    plt.tight_layout()
    plt.savefig(path, dpi=200, facecolor=fig.get_facecolor())


# ------------------------------------------------------------------ main
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--synthetic", choices=["coint", "null"])
    ap.add_argument("--no-show", action="store_true")
    args = ap.parse_args()

    A, I = TICKERS
    px = load_prices(args.synthetic)
    logp = np.log(px)
    split = int(len(logp) * TRAIN_FRAC)
    train, test = logp.iloc[:split], logp.iloc[split:]
    print(f"Data: {px.index[0].date()} to {px.index[-1].date()} | train {len(train)}d | test {len(test)}d")

    # ---- everything below is estimated on TRAIN only
    p_train = coint(train[A], train[I])[1]
    alpha, beta = fit_hedge(train)
    if beta <= 0:
        raise SystemExit(f"Hedge ratio is {beta:.3f}. Negative beta means this isn't a long/short pair.")
    spread = logp[A] - beta * logp[I]
    hl_train = half_life(spread.iloc[:split])

    # ---- out-of-sample health check: did the relationship survive?
    p_adf_test = adf_pvalue(spread.iloc[split:])
    _, beta_test = fit_hedge(test)
    hl_test = half_life(spread.iloc[split:])

    print("\n--- Relationship diagnostics (log prices) ---")
    print(f"Train cointegration p-value : {p_train:.4f}")
    print(f"Train hedge ratio (beta)    : {beta:.3f}   | refit on test: {beta_test:.3f}")
    print(f"Half-life train / test      : {hl_train:.1f} / {hl_test:.1f} days")
    print(f"ADF p-value, spread on TEST : {p_adf_test:.4f}   <-- the one that matters")

    # ---- backtest on real test prices
    z = ((spread - spread.rolling(WINDOW).mean()) / spread.rolling(WINDOW).std()).iloc[split:]
    spread_ret = spread.diff().iloc[split:]
    scale = LEVERAGE / (1 + abs(beta))
    pos, trades = generate_positions(z, spread_ret, scale)

    held = pos.shift(1).fillna(0.0)
    turnover = pos.diff().abs().fillna(pos.abs())
    strat_ret = held * scale * spread_ret - turnover * LEVERAGE * COST_BPS / 1e4
    strat_ret = strat_ret.dropna()
    equity = START_CAPITAL * (1 + strat_ret).cumprod()

    m = metrics(strat_ret)
    m["pct_days_in_market"] = (held != 0).mean()
    print("\n--- Backtest on REAL test prices (net of costs) ---")
    print(f"Total return : {m['total_return']:+.2%}   CAGR: {m['cagr']:+.2%}")
    print(f"Sharpe       : {m['sharpe']:.2f}")
    print(f"Max drawdown : {m['max_drawdown']:.2%}")
    print(f"Time in mkt  : {m['pct_days_in_market']:.0%}")
    print(f"Final equity : ${equity.iloc[-1]:,.2f} (start ${START_CAPITAL:,.0f})")

    if len(trades):
        w = trades["net_ret"] > 0
        print(f"\nTrades: {len(trades)} | win rate {w.mean():.0%} | "
              f"avg win {trades.loc[w, 'net_ret'].mean():+.2%} | "
              f"avg loss {trades.loc[~w, 'net_ret'].mean():+.2%}")
        print("Exit reasons:", trades["exit_reason"].value_counts().to_dict())
    else:
        print("\nNo trades triggered.")

    plot(z, trades if len(trades) else pd.DataFrame(columns=["start", "end", "net_ret"]),
         equity, OUT_PNG)
    print(f"\nChart saved to {OUT_PNG}")
    if not args.no_show:
        plt.show()


if __name__ == "__main__":
    main()
