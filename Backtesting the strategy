import datetime as dt
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.tsa.stattools import coint
import yfinance as yf

# ==========================================
# 1. DATA LOADING & TRAIN/TEST SPLIT
# ==========================================
stocks = ["AMD", "INTC"]
years = 5
end = dt.datetime.now()
start = end - dt.timedelta(days=365 * years)

print("Downloading historical data for AMD and INTC...")
close = yf.download(stocks, start=start, end=end, auto_adjust=True)["Close"]
if isinstance(close, pd.DataFrame):
  close = close.dropna()
else:
  close = close.to_frame().dropna()

train_size = int(len(close) * 0.625)
train_df = close.iloc[:train_size]
test_df = close.iloc[train_size:].copy()

# ==========================================
# 2. COINTEGRATION & OLS HEDGE RATIO
# ==========================================
score, p_value, crit_value = coint(train_df["AMD"], train_df["INTC"])
print(f"\n--- Cointegration Test ---")
print(f"Cointegration P-Value: {p_value:.4f}")
if p_value < 0.05:
  print("Status: Pair is cointegrated! Safe to trade.")
else:
  print("Status: Warning: Pair is NOT cointegrated.")

X = sm.add_constant(train_df["INTC"])
model = sm.OLS(train_df["AMD"], X).fit()
alpha = model.params["const"]
beta = model.params["INTC"]
print(f"\n--- OLS Regression ---")
print(f"Hedge Ratio (Beta): {beta:.4f}, Alpha: {alpha:.4f}")

# ==========================================
# 3. EXTRACT TRAIN SPREAD PARAMETERS
# ==========================================
train_spread = train_df["AMD"] - (beta * train_df["INTC"])
spread_mean = train_spread.mean()
spread_std = train_spread.std()

# ==========================================
# 4. MONTE CARLO SIMULATIONS (30 Paths)
# ==========================================
num_simulations = 30
sim_steps = len(test_df)
starting_capital = 10000.0

print(
    f"\nRunning {num_simulations} stochastic Monte Carlo simulations over"
    f" {sim_steps} trading days..."
)
simulation_results = np.zeros((sim_steps, num_simulations))

for sim in range(num_simulations):
  sim_shocks = np.random.normal(0, spread_std, sim_steps)
  sim_spread = np.zeros(sim_steps)
  sim_spread[0] = train_spread.iloc[-1]

  for t in range(1, sim_steps):
    sim_spread[t] = (
        sim_spread[t - 1]
        + 0.1 * (spread_mean - sim_spread[t - 1])
        + sim_shocks[t]
    )

  simulation_results[:, sim] = sim_spread

# ==========================================
# 5. BACKTEST STRATEGY & PRE-TRADE KELLY SIZING
# ==========================================
window = 30
max_holding_days = 20
performance_logs = []
sample_trade_records = []
sample_z_series = None

for sim in range(num_simulations):
  s_series = pd.Series(simulation_results[:, sim])
  r_mean = s_series.rolling(window=window).mean()
  r_std = s_series.rolling(window=window).std()
  z_score = (s_series - r_mean) / r_std

  position = 0  # 0: Flat, 1: Long Spread, -1: Short Spread
  trades = 0
  wins = 0
  portfolio_value = starting_capital
  days_in_trade = 0
  trade_returns = []
  trade_records = []

  entry_idx = None
  entry_z = 0

  for i in range(window, len(s_series)):
    z = z_score.iloc[i]
    if pd.isna(z):
      continue

    if position != 0:
      days_in_trade += 1

    if position == 0:
      if z < -2.0:
        position = 1
        entry_idx = i
        entry_z = z
        days_in_trade = 0
      elif z > 2.0:
        position = -1
        entry_idx = i
        entry_z = z
        days_in_trade = 0

    elif position == 1:
      if z >= 0.0 or z < -3.5 or days_in_trade >= max_holding_days:
        exit_idx = i
        exit_z = z
        trade_pnl = exit_z - entry_z
        pnl_pct = (trade_pnl / abs(entry_z)) if entry_z != 0 else 0.0

        risk = abs(entry_z - (-3.5))
        reward = abs(exit_z - entry_z)
        rr_ratio = reward / risk if risk > 0 else 0.0

        # --- Pre-Trade Kelly Criterion Estimation ---
        # Using historical win rate & payout ratio prior to this trade, 
        # or defaults (50% win rate, 1.0 payoff ratio) if no prior trades yet.
        if trades > 0 and len(trade_returns) > 0:
          current_wins = sum(1 for r in trade_returns if r > 0)
          est_win_rate = current_wins / trades
          wins_list = [r for r in trade_returns if r > 0]
          losses_list = [abs(r) for r in trade_returns if r < 0]
          avg_win = np.mean(wins_list) if len(wins_list) > 0 else 0.0
          avg_loss = np.mean(losses_list) if len(losses_list) > 0 else 0.0001
          b_ratio = (avg_win / avg_loss) if avg_loss > 0 else 1.0
          kelly_f = max(
              0.0,
              min(
                  ((est_win_rate * (b_ratio + 1) - 1) / b_ratio)
                  if b_ratio > 0
                  else 0.1,
                  1.0,
              ),
          )
        else:
          kelly_f = 0.15  # Default conservative initial allocation before first trade

        # Use Half-Kelly fractional sizing to position-size the dollar risk
        position_capital = portfolio_value * (kelly_f * 0.5)
        portfolio_value += trade_pnl * (position_capital / 100.0)

        trades += 1
        if trade_pnl > 0:
          wins += 1
        trade_returns.append(pnl_pct)

        if sim == 0:
          trade_records.append({
              "start": entry_idx,
              "end": exit_idx,
              "entry_z": entry_z,
              "pnl_pct": pnl_pct * 100,
              "rr": rr_ratio,
              "win": trade_pnl > 0,
          })

        position = 0
        days_in_trade = 0

    elif position == -1:
      if z <= 0.0 or z > 3.5 or days_in_trade >= max_holding_days:
        exit_idx = i
        exit_z = z
        trade_pnl = entry_z - exit_z
        pnl_pct = (trade_pnl / abs(entry_z)) if entry_z != 0 else 0.0

        risk = abs(entry_z - 3.5)
        reward = abs(entry_z - exit_z)
        rr_ratio = reward / risk if risk > 0 else 0.0

        if trades > 0 and len(trade_returns) > 0:
          current_wins = sum(1 for r in trade_returns if r > 0)
          est_win_rate = current_wins / trades
          wins_list = [r for r in trade_returns if r > 0]
          losses_list = [abs(r) for r in trade_returns if r < 0]
          avg_win = np.mean(wins_list) if len(wins_list) > 0 else 0.0
          avg_loss = np.mean(losses_list) if len(losses_list) > 0 else 0.0001
          b_ratio = (avg_win / avg_loss) if avg_loss > 0 else 1.0
          kelly_f = max(
              0.0,
              min(
                  ((est_win_rate * (b_ratio + 1) - 1) / b_ratio)
                  if b_ratio > 0
                  else 0.1,
                  1.0,
              ),
          )
        else:
          kelly_f = 0.15

        position_capital = portfolio_value * (kelly_f * 0.5)
        portfolio_value += trade_pnl * (position_capital / 100.0)

        trades += 1
        if trade_pnl > 0:
          wins += 1
        trade_returns.append(pnl_pct)

        if sim == 0:
          trade_records.append({
              "start": entry_idx,
              "end": exit_idx,
              "entry_z": entry_z,
              "pnl_pct": pnl_pct * 100,
              "rr": rr_ratio,
              "win": trade_pnl > 0,
          })

        position = 0
        days_in_trade = 0

  total_gain_pct = (portfolio_value / starting_capital) - 1.0
  win_rate = (wins / trades) if trades > 0 else 0.0

  performance_logs.append({
      "Simulation": sim + 1,
      "Total_Trades": trades,
      "Win_Rate_%": win_rate * 100,
      "Final_Portfolio_Value": portfolio_value,
      "Total_Gain_%": total_gain_pct,
  })

  if sim == 0:
    sample_trade_records = trade_records
    sample_z_series = z_score

perf_df = pd.DataFrame(performance_logs)

# ==========================================
# 6. TERMINAL SUMMARY DISPLAY
# ==========================================
display_df = perf_df.head(10).copy()
display_df["Win_Rate_%"] = display_df["Win_Rate_%"].apply(lambda x: f"{x:.1f}%")
display_df["Final_Portfolio_Value"] = display_df["Final_Portfolio_Value"].apply(
    lambda x: f"${x:,.2f}"
)
display_df["Total_Gain_%"] = display_df["Total_Gain_%"].apply(
    lambda x: f"{x * 100:.2f}%"
)

print(
    "\n--- Monte Carlo Backtest Summary with Pre-Trade Kelly Sizing (First 10"
    " Simulations) ---"
)
print(display_df.to_string(index=False))

print(
    f"\nAverage Final Portfolio Value: "
    f"${perf_df['Final_Portfolio_Value'].mean():,.2f}"
)
print(f"Average Total Gain: {perf_df['Total_Gain_%'].mean() * 100:.2f}%")

# ==========================================
# 7. MATPLOTLIB VISUALIZATION (Simulation #1)
# ==========================================
fig, ax = plt.subplots(figsize=(14, 7), facecolor="#0b0f19")
ax.set_facecolor("#0b0f19")

ax.plot(
    sample_z_series.index,
    sample_z_series,
    color="#38bdf8",
    linewidth=1.8,
    label="Simulated Z-Score (Path #1)",
    zorder=3,
)
ax.axhline(0, color="#64748b", linestyle="--", alpha=0.6, linewidth=1)
ax.axhline(2.0, color="#ef4444", linestyle="-", alpha=0.9, linewidth=1.2)
ax.axhline(-2.0, color="#10b981", linestyle="-", alpha=0.9, linewidth=1.2)

ax.axhspan(2.0, sample_z_series.max() + 1.0, color="#ef4444", alpha=0.12)
ax.axhspan(-2.0, sample_z_series.min() - 1.0, color="#10b981", alpha=0.12)

for tr in sample_trade_records:
  start, end = tr["start"], tr["end"]
  pnl = tr["pnl_pct"]
  rr = tr["rr"]
  is_win = tr["win"]

  span_color = "#10b981" if is_win else "#ef4444"
  ax.axvspan(start, end, color=span_color, alpha=0.22, zorder=2)
  ax.scatter([start], [tr["entry_z"]], color="#f59e0b", s=65, zorder=5)

  mid_x = start + (end - start) / 2
  window_slice = sample_z_series.loc[start:end]
  label_y = (
      window_slice.max() + 0.4
      if not window_slice.empty
      else tr["entry_z"] + 0.4
  )

  text_str = f"PnL: {pnl:+.1f}%\nRR: {rr:.1f}"
  ax.text(
      mid_x,
      label_y,
      text_str,
      color="white",
      fontsize=8,
      fontweight="bold",
      ha="center",
      va="bottom",
      bbox=dict(
          boxstyle="round,pad=0.2",
          facecolor="#1e293b",
          edgecolor=span_color,
          alpha=0.85,
      ),
  )

sim1_trades = perf_df.loc[0, "Total_Trades"]
sim1_wins = perf_df.loc[0, "Win_Rate_%"]
sim1_gain = perf_df.loc[0, "Total_Gain_%"] * 100
ax.set_title(
    f"MONTE CARLO SIMULATION #1 WITH KELLY SIZING | {sim1_trades} TRADES — WIN"
    f" RATE: {sim1_wins:.1f}% | GAIN: {sim1_gain:+.2f}%",
    color="white",
    fontsize=14,
    fontweight="bold",
    pad=25,
)

ax.tick_params(colors="#94a3b8", labelsize=11)
for spine in ax.spines.values():
  spine.set_color("#1e293b")

plt.grid(visible=True, color="#1e293b", linestyle=":", alpha=0.5)
plt.tight_layout()

output_filename = "monte_carlo_kelly_simulation_chart.png"
plt.savefig(output_filename, dpi=300, facecolor=fig.get_facecolor())
print(f"Plot successfully saved as '{output_filename}'.")
plt.show()
