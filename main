import datetime as dt
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.tsa.stattools import coint
import yfinance as yf

# ==========================================
# 1. DATA LOADING & TRAIN/TEST SPLIT
# ==========================================
stocks = ["AMD", "INTC"]
years = 5
end = dt.datetime.now()
start = end - dt.timedelta(days=365 * years)  # Fixed date math

print("Downloading historical data for AMD and INTC...")
close = yf.download(stocks, start=start, end=end, auto_adjust=True)["Close"]
if isinstance(close, pd.DataFrame):
  close = close.dropna()
else:
  close = close.to_frame().dropna()

# Train/Test Split (First 62.5% for training parameters)
train_size = int(len(close) * 0.625)
train_df = close.iloc[:train_size]
test_df = close.iloc[train_size:].copy()

# ==========================================
# 2. COINTEGRATION & OLS HEDGE RATIO
# ==========================================
score, p_value, crit_value = coint(train_df["AMD"], train_df["INTC"])
print(f"\n--- Cointegration Test ---")
print(f"Cointegration P-Value: {p_value:.4f}")
if p_value < 0.05:
  print("Status: Pair is cointegrated! Safe to trade.")
else:
  print("Status: Warning: Pair is NOT cointegrated.")

# OLS Regression on Training Prices: AMD = beta * INTC + alpha
X = sm.add_constant(train_df["INTC"])
model = sm.OLS(train_df["AMD"], X).fit()
alpha = model.params["const"]
beta = model.params["INTC"]
print(f"\n--- OLS Regression ---")
print(f"Hedge Ratio (Beta): {beta:.4f}, Alpha: {alpha:.4f}")

# ==========================================
# 3. CALCULATE SPREAD & ROLLING Z-SCORE
# ==========================================
data = close.copy()
data["Spread"] = data["AMD"] - (beta * data["INTC"])

window = 30
data["Rolling_Mean"] = data["Spread"].rolling(window=window).mean()
data["Rolling_Std"] = data["Spread"].rolling(window=window).std()
data["Z_Score"] = (data["Spread"] - data["Rolling_Mean"]) / data["Rolling_Std"]
data = data.dropna()

# Isolate out-of-sample test set with calculated Z-scores
test_processed = data.iloc[train_size:].copy()
z_series = test_processed["Z_Score"]

# ==========================================
# 4. BACKTESTING STATE MACHINE (WITH PnL & RR)
# ==========================================
position = 0  # 0: Flat, 1: Long Spread, -1: Short Spread
trades = 0
wins = 0
total_pnl_pct = 0.0
trade_records = []

max_holding_days = 20
days_in_trade = 0
entry_idx = None
entry_z = 0

for i in range(len(z_series)):
  z = z_series.iloc[i]
  current_idx = z_series.index[i]

  if position != 0:
    days_in_trade += 1

  if position == 0:
    if z < -2.0:
      position = 1  # Long Spread (Buy AMD, Sell INTC)
      entry_idx = current_idx
      entry_z = z
      days_in_trade = 0
    elif z > 2.0:
      position = -1  # Short Spread (Sell AMD, Buy INTC)
      entry_idx = current_idx
      entry_z = z
      days_in_trade = 0

  elif position == 1:
    # Exit conditions: mean reversion (z >= 0), stop-loss (z < -3.5), or max holding period
    if z >= 0.0 or z < -3.5 or days_in_trade >= max_holding_days:
      exit_idx = current_idx
      exit_z = z
      pnl_val = exit_z - entry_z
      pnl_pct = (pnl_val / abs(entry_z)) * 100 if entry_z != 0 else 0.0

      risk = abs(entry_z - (-3.5))
      reward = abs(exit_z - entry_z)
      rr_ratio = reward / risk if risk > 0 else 0.0

      trades += 1
      if pnl_val > 0:
        wins += 1
      total_pnl_pct += pnl_pct

      trade_records.append({
          "start": entry_idx,
          "end": exit_idx,
          "entry_z": entry_z,
          "pnl_pct": pnl_pct,
          "rr": rr_ratio,
          "win": pnl_val > 0,
      })
      position = 0
      days_in_trade = 0

  elif position == -1:
    # Exit conditions: mean reversion (z <= 0), stop-loss (z > 3.5), or max holding period
    if z <= 0.0 or z > 3.5 or days_in_trade >= max_holding_days:
      exit_idx = current_idx
      exit_z = z
      pnl_val = entry_z - exit_z
      pnl_pct = (pnl_val / abs(entry_z)) * 100 if entry_z != 0 else 0.0

      risk = abs(entry_z - 3.5)
      reward = abs(entry_z - exit_z)
      rr_ratio = reward / risk if risk > 0 else 0.0

      trades += 1
      if pnl_val > 0:
        wins += 1
      total_pnl_pct += pnl_pct

      trade_records.append({
          "start": entry_idx,
          "end": exit_idx,
          "entry_z": entry_z,
          "pnl_pct": pnl_pct,
          "rr": rr_ratio,
          "win": pnl_val > 0,
      })
      position = 0
      days_in_trade = 0

print(
    f"\nBacktest complete across {len(z_series)} out-of-sample trading days."
)
print(
    f"Total Trades: {trades} | Wins: {wins} | Win Rate:"
    f" {(wins/trades*100) if trades > 0 else 0:.1f}%"
)

# ==========================================
# 5. MATPLOTLIB VISUALIZATION
# ==========================================
fig, ax = plt.subplots(figsize=(14, 7), facecolor="#0b0f19")
ax.set_facecolor("#0b0f19")

# Plot the real calculated Z-score series from test data
ax.plot(
    z_series.index,
    z_series,
    color="#38bdf8",
    linewidth=1.8,
    label="Calculated Z-Score",
    zorder=3,
)
ax.axhline(0, color="#64748b", linestyle="--", alpha=0.6, linewidth=1)
ax.axhline(2.0, color="#ef4444", linestyle="-", alpha=0.9, linewidth=1.2)
ax.axhline(-2.0, color="#10b981", linestyle="-", alpha=0.9, linewidth=1.2)

ax.axhspan(2.0, z_series.max() + 1.0, color="#ef4444", alpha=0.12)
ax.axhspan(-2.0, z_series.min() - 1.0, color="#10b981", alpha=0.12)

# Highlight trade spans and annotate PnL% and RR
for tr in trade_records:
  start, end = tr["start"], tr["end"]
  pnl = tr["pnl_pct"]
  rr = tr["rr"]
  is_win = tr["win"]

  span_color = "#10b981" if is_win else "#ef4444"
  ax.axvspan(start, end, color=span_color, alpha=0.22, zorder=2)
  ax.scatter([start], [tr["entry_z"]], color="#f59e0b", s=65, zorder=5)

  mid_x = start + (end - start) / 2
  # Position label slightly above the max local height in that trade window
  window_slice = z_series.loc[start:end]
  label_y = (
      window_slice.max() + 0.4
      if not window_slice.empty
      else tr["entry_z"] + 0.4
  )

  text_str = f"PnL: {pnl:+.1f}%\nRR: {rr:.1f}"
  ax.text(
      mid_x,
      label_y,
      text_str,
      color="white",
      fontsize=8,
      fontweight="bold",
      ha="center",
      va="bottom",
      bbox=dict(
          boxstyle="round,pad=0.2",
          facecolor="#1e293b",
          edgecolor=span_color,
          alpha=0.85,
      ),
  )

win_rate = (wins / trades * 100) if trades > 0 else 0
avg_pnl = (total_pnl_pct / trades) if trades > 0 else 0
ax.set_title(
    f"AMD vs INTC PAIRS TRADING TEST SET | {trades} TRADES — {wins} WON"
    f" ({win_rate:.0f}%) | AVG P&L: {avg_pnl:+.1f}%",
    color="white",
    fontsize=14,
    fontweight="bold",
    pad=25,
)

ax.tick_params(colors="#94a3b8", labelsize=11)
for spine in ax.spines.values():
  spine.set_color("#1e293b")

plt.grid(visible=True, color="#1e293b", linestyle=":", alpha=0.5)
plt.tight_layout()

output_filename = "amd_intc_pairs_backtest_chart.png"
plt.savefig(output_filename, dpi=300, facecolor=fig.get_facecolor())
print(f"Plot successfully saved as '{output_filename}'.")
plt.show()
