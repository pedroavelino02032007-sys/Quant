# ---------------------------------------------------------------------------
# Shared Thread-Safe State
# ---------------------------------------------------------------------------
TICK_COLUMNS = ["tick_id", "timestamp", "price", "size", "SMA_short", "SMA_long", "Signal"]

_data_lock = threading.Lock()
_stop_event = threading.Event()
tick_data = pd.DataFrame(columns=TICK_COLUMNS)
_tick_counter = 0

_ws_app: websocket.WebSocketApp | None = None
_ws_thread: threading.Thread | None = None
_trading_thread: threading.Thread | None = None


def get_tick_snapshot() -> pd.DataFrame:
    """Return a thread-safe copy of the rolling tick DataFrame."""
    with _data_lock:
        return tick_data.copy()


# ---------------------------------------------------------------------------
# Signal Calculation
# ---------------------------------------------------------------------------
def calculate_signals(df: pd.DataFrame) -> pd.DataFrame:
    """Compute short/long tick SMAs and mark crossover buy (1) / sell (-1) signals."""
    df = df.copy()
    df["Signal"] = 0

    if len(df) < CFG.long_window:
        df["SMA_short"] = pd.NA
        df["SMA_long"] = pd.NA
        return df

    df["SMA_short"] = df["price"].rolling(window=CFG.short_window).mean()
    df["SMA_long"] = df["price"].rolling(window=CFG.long_window).mean()

    buy_cross = (df["SMA_short"] > df["SMA_long"]) & (
        df["SMA_short"].shift(1) <= df["SMA_long"].shift(1)
    )
    sell_cross = (df["SMA_short"] < df["SMA_long"]) & (
        df["SMA_short"].shift(1) >= df["SMA_long"].shift(1)
    )

    df.loc[buy_cross, "Signal"] = 1
    df.loc[sell_cross, "Signal"] = -1
    return df


# ---------------------------------------------------------------------------
# Finnhub WebSocket Handlers
# ---------------------------------------------------------------------------
def on_open(ws) -> None:
    """Subscribe to the target ticker once the authenticated Finnhub socket opens."""
    logger.info(
        "Finnhub WebSocket opened (key: %s...). Subscribing to %s...",
        CFG.finnhub_api_key[:5],
        CFG.stream_symbol,
    )
    subscribe_payload = {
        "type": "subscribe",
        "symbol": CFG.stream_symbol,
    }
    ws.send(json.dumps(subscribe_payload))
    logger.info("Subscription sent for %s trades.", CFG.stream_symbol)


def on_message(ws, message: str) -> None:
    """Parse incoming Finnhub trade messages, update tick_data, and recalculate signals."""
    global tick_data, _tick_counter
    try:
        payload = json.loads(message)

        # Ignore heartbeat pings or non-trade events
        if not isinstance(payload, dict) or payload.get("type") != "trade":
            return

        trades = payload.get("data", [])
        if not trades:
            return

        new_rows = []
        with _data_lock:
            for trade in trades:
                if "p" in trade and "v" in trade and "t" in trade:
                    _tick_counter += 1
                    new_rows.append(
                        {
                            "tick_id": _tick_counter,
                            "timestamp": pd.Timestamp(trade["t"], unit="ms"),
                            "price": float(trade["p"]),
                            "size": float(trade["v"]),  # Finnhub uses 'v' for volume ('s' is symbol)
                        }
                    )

            if not new_rows:
                return

            new_df = pd.DataFrame(new_rows)
            if tick_data.empty:
                combined = new_df
            else:
                base_cols = ["tick_id", "timestamp", "price", "size"]
                combined = pd.concat([tick_data[base_cols], new_df], ignore_index=True)

            # Cap buffer to the latest N ticks for flat memory usage
            if len(combined) > CFG.max_ticks:
                combined = combined.tail(CFG.max_ticks).reset_index(drop=True)

            tick_data = calculate_signals(combined)
            latest = tick_data.iloc[-1]

        if latest["Signal"] in (1, -1):
            label = "BUY" if latest["Signal"] == 1 else "SELL"
            logger.info(
                "[SIGNAL] %s crossover detected at $%.2f (tick #%d)",
                label,
                latest["price"],
                int(latest["tick_id"]),
            )
    except Exception as exc:
        logger.error("Error processing WebSocket message: %s", exc)


def on_error(ws, error) -> None:
    """Log WebSocket transport or authentication errors."""
    logger.error("Finnhub WebSocket error: %s", error)


def on_close(ws, close_status_code, close_msg) -> None:
    """Log WebSocket disconnects."""
    logger.info(
        "Finnhub WebSocket closed (code=%s, msg=%s).",
        close_status_code,
        close_msg,
    )


def start_finnhub_ws() -> None:
    """Maintain the Finnhub WebSocket connection with automatic reconnect."""
    global _ws_app
    if not CFG.finnhub_api_key or CFG.finnhub_api_key == "PUT_FINNHUB_KEY_HERE":
        logger.error(
            "Finnhub API key is not set. Set FINNHUB_API_KEY env var or update Config.finnhub_api_key."
        )
        return

    # Finnhub authenticates via the token query parameter
    ws_url = f"wss://ws.finnhub.io?token={CFG.finnhub_api_key}"

    while not _stop_event.is_set():
        _ws_app = websocket.WebSocketApp(
            ws_url,
            on_open=on_open,
            on_message=on_message,
            on_error=on_error,
            on_close=on_close,
        )
        _ws_app.run_forever(ping_interval=20, ping_timeout=10)

        if not _stop_event.is_set():
            logger.info("Reconnecting to Finnhub in %ds...", CFG.reconnect_delay_seconds)
            _stop_event.wait(CFG.reconnect_delay_seconds)


# ---------------------------------------------------------------------------
# Interactive Brokers Helpers & Trading Listener Thread
# ---------------------------------------------------------------------------
def _attach_ib_callbacks(ib: IB) -> None:
    def on_ib_error(reqId, code, msg, contract=None):
        if code in IB_INFO_CODES:
            logger.info("IB info [code=%s]: %s", code, msg)
        else:
            logger.warning("IB message [reqId=%s, code=%s]: %s", reqId, code, msg)

    def on_order_status(trade):
        logger.info(
            "[ORDER] ID=%s | Status=%s | Filled=%s | AvgFill=%.2f",
            trade.order.orderId,
            trade.orderStatus.status,
            trade.orderStatus.filled,
            trade.orderStatus.avgFillPrice,
        )

    ib.errorEvent += on_ib_error
    ib.orderStatusEvent += on_order_status


def _connect_ib(ib: IB) -> bool:
    if ib.isConnected():
        return True
    try:
        logger.info(
            "Connecting to TWS at %s:%s (clientId=%s)...",
            CFG.ib_host,
            CFG.ib_port,
            CFG.ib_client_id,
        )
        ib.connect(
            CFG.ib_host,
            CFG.ib_port,
            clientId=CFG.ib_client_id,
            timeout=CFG.ib_connect_timeout,
        )
        ib.reqMarketDataType(3)
        logger.info("Connected to TWS! Server time: %s", ib.reqCurrentTime())
        return True
    except Exception as exc:
        logger.error("TWS connection failed: %s", exc)
        return False


def _get_position(ib: IB, symbol: str) -> float:
    return sum(pos.position for pos in ib.positions() if pos.contract.symbol == symbol)


def _has_pending_order(ib: IB, symbol: str) -> bool:
    open_trades = ib.reqAllOpenOrders()
    return any(t.contract.symbol == symbol and not t.isDone() for t in open_trades)


def _execute_ib_order(ib: IB, contract: Stock, signal_value: int) -> bool:
    """Execute a BUY (1) or SELL (-1) market order with position & duplicate guards."""
    if _has_pending_order(ib, contract.symbol):
        logger.warning("Pending %s order exists. Skipping signal.", contract.symbol)
        return False

    current_pos = _get_position(ib, contract.symbol)
    max_shares = CFG.max_positions * CFG.position_size

    if signal_value == 1:
        if current_pos >= max_shares:
            logger.info("At max position (%s shares). Skipping BUY.", current_pos)
            return False
        action = "BUY"
        qty = CFG.position_size
    elif signal_value == -1:
        if current_pos <= 0:
            logger.info("No %s shares held. Skipping SELL.", contract.symbol)
            return False
        action = "SELL"
        qty = min(CFG.position_size, current_pos)
    else:
        return False

    trade = ib.placeOrder(contract, MarketOrder(action, qty, transmit=True))
    logger.info(
        "Submitted %s market order for %s %s (ID=%s).",
        action,
        qty,
        contract.symbol,
        trade.order.orderId,
    )

    for _ in range(CFG.order_wait_seconds):
        ib.sleep(1)
        if trade.isDone():
            break

    updated_pos = _get_position(ib, contract.symbol)
    logger.info("Updated %s position: %s shares.", contract.symbol, updated_pos)
    return True


def _trading_listener_loop() -> None:
    """Monitor tick_data for new crossover signals and route orders on a dedicated IBKR loop."""
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    nest_asyncio.apply(loop)

    ib = IB()
    _attach_ib_callbacks(ib)
    contract: Stock | None = None

    last_processed_tick_id = 0
    last_trade_ts = 0.0
    seconds_elapsed = 0

    logger.info(
        "Trading listener started | Auto-trading=%s | Symbol=%s",
        "ENABLED" if CFG.execute_trades else "SIMULATION ONLY",
        CFG.ib_symbol,
    )

    try:
        while not _stop_event.is_set():
            try:
                if CFG.execute_trades and not ib.isConnected():
                    if _connect_ib(ib):
                        candidate = Stock(CFG.ib_symbol, CFG.ib_exchange, CFG.ib_currency)
                        qualified = ib.qualifyContracts(candidate)
                        contract = qualified[0] if qualified else None
                        if contract is None:
                            logger.error("Failed to qualify contract %s.", CFG.ib_symbol)

                df = get_tick_snapshot()
                seconds_elapsed += 1

                if seconds_elapsed % 30 == 0:
                    if df.empty:
                        logger.info("[STATUS] Waiting for Finnhub ticks for %s...", CFG.stream_symbol)
                    else:
                        latest = df.iloc[-1]
                        logger.info(
                            "[STATUS] Ticks=%d | Price=$%.2f | SMA%d=%s | SMA%d=%s",
                            len(df),
                            latest["price"],
                            CFG.short_window,
                            f"{latest['SMA_short']:.2f}" if pd.notna(latest["SMA_short"]) else "n/a",
                            CFG.long_window,
                            f"{latest['SMA_long']:.2f}" if pd.notna(latest["SMA_long"]) else "n/a",
                        )

                if len(df) >= CFG.long_window:
                    new_signals = df[(df["Signal"] != 0) & (df["tick_id"] > last_processed_tick_id)]
                    if not new_signals.empty:
                        latest_sig = new_signals.iloc[-1]
                        last_processed_tick_id = int(latest_sig["tick_id"])
                        sig_val = int(latest_sig["Signal"])
                        sig_price = float(latest_sig["price"])
                        sig_label = "BUY" if sig_val == 1 else "SELL"

                        now_ts = time.monotonic()
                        if now_ts - last_trade_ts < CFG.cooldown_seconds:
                            logger.info(
                                "Signal %s at $%.2f skipped (cooldown %ds active).",
                                sig_label,
                                sig_price,
                                CFG.cooldown_seconds,
                            )
                        elif CFG.execute_trades:
                            if ib.isConnected() and contract is not None:
                                if _execute_ib_order(ib, contract, sig_val):
                                    last_trade_ts = time.monotonic()
                            else:
                                logger.warning("Signal %s missed: TWS not connected.", sig_label)
                        else:
                            logger.info(
                                "[SIMULATION] Would %s %d share(s) of %s at $%.2f",
                                sig_label,
                                CFG.position_size,
                                CFG.ib_symbol,
                                sig_price,
                            )
                            last_trade_ts = time.monotonic()

            except Exception as exc:
                logger.exception("Error in trading listener: %s", exc)

            if ib.isConnected():
                ib.sleep(1)
            else:
                _stop_event.wait(1)
    finally:
        if ib.isConnected():
            ib.disconnect()
        logger.info("Trading listener stopped and disconnected.")
        loop.close()


# ---------------------------------------------------------------------------
# Live Visualization (Main Thread)
# ---------------------------------------------------------------------------
def visualize_trade_data(
    interval=5,
    min_points=50,
    symbol="SPY",
    short_window=20,
    long_window=50,
):
    """
    Visualize real-time trading data with price, moving averages, and buy/sell signals.
    Thread-safe and compatible with both Jupyter/Datalore notebooks and local Python scripts.

    Args:
        interval (int): Refresh interval in seconds.
        min_points (int): Minimum data points required before plotting.
        symbol (str): Ticker label shown in the chart title.
        short_window (int): Short SMA period label for the legend.
        long_window (int): Long SMA period label for the legend.
    """
    stop_event = globals().get("_stop_event")
    data_lock = globals().get("_data_lock")

    print(
        f"Visualization started for {symbol} (refresh every {interval}s). "
        "Interrupt the cell or press Ctrl+C to stop."
    )

    fig, ax = None, None
    if not IN_NOTEBOOK:
        plt.ion()
        fig, ax = plt.subplots(figsize=(14, 7))

    def _wait(seconds):
        if stop_event is not None:
            stop_event.wait(seconds)
        else:
            time.sleep(seconds)

    try:
        while not (stop_event and stop_event.is_set()):
            nb_fig = None
            try:
                # Take a single atomic snapshot so background ticks cannot mutate data mid-plot
                if "tick_data" not in globals():
                    print("Waiting for tick_data to be initialized...", end="\r", flush=True)
                    _wait(interval)
                    continue

                if data_lock is not None:
                    with data_lock:
                        df = tick_data.copy()
                else:
                    df = tick_data.copy()

                if len(df) < min_points:
                    print(
                        f"Waiting for more data... ({len(df)}/{min_points} ticks)",
                        end="\r",
                        flush=True,
                    )
                    _wait(interval)
                    continue

                if IN_NOTEBOOK:
                    clear_output(wait=True)
                    nb_fig, ax = plt.subplots(figsize=(14, 7))
                    active_fig = nb_fig
                else:
                    ax.clear()
                    active_fig = fig

                # Plot price and moving averages
                ax.plot(df["timestamp"], df["price"], label="Price", color="blue", alpha=0.75)

                if "SMA_short" in df.columns and not df["SMA_short"].isna().all():
                    ax.plot(
                        df["timestamp"],
                        df["SMA_short"],
                        label=f"Short MA ({short_window})",
                        linestyle="--",
                        color="green",
                    )

                if "SMA_long" in df.columns and not df["SMA_long"].isna().all():
                    ax.plot(
                        df["timestamp"],
                        df["SMA_long"],
                        label=f"Long MA ({long_window})",
                        linestyle="--",
                        color="red",
                    )

                # Plot buy/sell crossover markers above the lines
                buy_signals = pd.DataFrame()
                sell_signals = pd.DataFrame()
                if "Signal" in df.columns:
                    buy_signals = df[df["Signal"] == 1]
                    sell_signals = df[df["Signal"] == -1]

                    if not buy_signals.empty:
                        ax.scatter(
                            buy_signals["timestamp"],
                            buy_signals["price"],
                            label="Buy",
                            marker="^",
                            color="green",
                            s=110,
                            zorder=5,
                        )
                    if not sell_signals.empty:
                        ax.scatter(
                            sell_signals["timestamp"],
                            sell_signals["price"],
                            label="Sell",
                            marker="v",
                            color="red",
                            s=110,
                            zorder=5,
                        )

                latest_price = df["price"].iloc[-1]
                ax.set_title(
                    f"{symbol} Real-Time Trading Signals — Latest: ${latest_price:.2f}",
                    fontsize=15,
                )
                ax.set_xlabel("Time", fontsize=12)
                ax.set_ylabel("Price ($)", fontsize=12)
                ax.legend(loc="upper left")
                ax.grid(True, alpha=0.3)
                active_fig.tight_layout()

                if IN_NOTEBOOK:
                    plt.show()
                else:
                    active_fig.canvas.draw()
                    plt.pause(interval)

                # Display stats from the exact same snapshot
                print(
                    f"Latest price: ${latest_price:.2f} | "
                    f"Data points: {len(df)} | "
                    f"Buy signals: {len(buy_signals)} | "
                    f"Sell signals: {len(sell_signals)}"
                )

                if IN_NOTEBOOK:
                    _wait(interval)

            except Exception as e:
                print(f"Visualization error: {e}")
                _wait(interval)
            finally:
                if nb_fig is not None:
                    plt.close(nb_fig)

    except KeyboardInterrupt:
        print("\nVisualization stopped by user.")
    finally:
        if not IN_NOTEBOOK and fig is not None:
            plt.ioff()
            plt.close(fig)

# ---------------------------------------------------------------------------
# Lifecycle Controls
# ---------------------------------------------------------------------------
def start_system(reset_data: bool = True, start_trader: bool = True) -> str:
    """
    Start the Finnhub WebSocket feed and (optionally) the IBKR trading listener.
    Safe to call repeatedly: will not spawn duplicate sockets or wipe live data.
    """
    global _ws_thread, _trading_thread, tick_data, _tick_counter

    # 1. Fail fast if the Finnhub key is missing
    if not CFG.finnhub_api_key or CFG.finnhub_api_key == "PUT_FINNHUB_KEY_HERE":
        msg = "Cannot start: Finnhub API key is not configured."
        logger.error(msg)
        return msg

    ws_alive = bool(_ws_thread and _ws_thread.is_alive())
    trader_alive = bool(_trading_thread and _trading_thread.is_alive())

    # 2. Prevent duplicate Finnhub connections and accidental tick_data wipes
    if ws_alive and (not start_trader or trader_alive):
        msg = "System is already running. Call stop_system() first to restart."
        logger.warning(msg)
        return msg

    _stop_event.clear()

    # 3. Reset buffer only on a fresh start (never while a live stream is writing)
    if reset_data and not ws_alive:
        with _data_lock:
            tick_data = pd.DataFrame(columns=TICK_COLUMNS)
            _tick_counter = 0

    # 4. Launch WebSocket thread if not already running
    if not ws_alive:
        _ws_thread = threading.Thread(
            target=start_finnhub_ws,
            daemon=True,
            name="Finnhub_WS_Thread",
        )
        _ws_thread.start()

    # 5. Launch IBKR trading listener if requested and not already running
    if start_trader and not trader_alive:
        _trading_thread = threading.Thread(
            target=_trading_listener_loop,
            daemon=True,
            name="IBKR_Listener_Thread",
        )
        _trading_thread.start()

    mode = "LIVE/PAPER" if CFG.execute_trades else "SIMULATION"
    msg = (
        f"Trading system running ({mode}) | Stream={CFG.stream_symbol} "
        "| Call stop_system() when finished."
    )
    logger.info(msg)
    return msg


# Optional alias if later notebook cells call `start_trading_system()`
start_trading_system = start_system

def stop_system() -> None:
    """Cleanly stop the WebSocket stream and disconnect from IBKR."""
    logger.info("Stopping system...")
    _stop_event.set()

    if _ws_app is not None:
        try:
            _ws_app.close()
        except Exception:
            pass

    if _ws_thread and _ws_thread.is_alive():
        _ws_thread.join(timeout=5)
    if _trading_thread and _trading_thread.is_alive():
        _trading_thread.join(timeout=10)

    logger.info("System stopped cleanly.")


# ---------------------------------------------------------------------------
# Entry Point
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    start_system()
    try:
        visualize_trade_data(interval=CFG.viz_interval_seconds)
    finally:
        stop_system()
